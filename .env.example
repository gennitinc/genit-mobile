# Server the app talks to. Defaults to the live server (the one the web app uses).
# Set this only to test against a local server; a physical device needs your computer's LAN IP.
# EXPO_PUBLIC_API_URL=http://localhost:8787/api/v1/

# Google Sign-In. The button stays hidden until these are set, and needs a
# development build (it can't run in Expo Go).
# Web: the same WEB client ID the web app/server uses, not the iOS or Android ID.
# iOS: create an iOS client for com.genit.app in Google Cloud Console.
# Keep the public web/iOS IDs in eas.json in sync for preview/production builds;
# .env.local is ignored and is not uploaded to EAS.
# Android: register com.genit.app and the build's signing SHA-1 in Google Cloud.
# The SDK does not take an Android client ID environment variable.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
