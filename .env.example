# Server the app talks to. Defaults: http://localhost:8000/api/v1/ in development,
# the live server in release builds. A physical device needs your computer's LAN IP.
# EXPO_PUBLIC_API_URL=http://localhost:8787/api/v1/

# Google Sign-In. The button stays hidden until these are set, and needs a
# development build (it can't run in Expo Go).
# Web: the same client ID the web app uses. iOS: create one in Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
